# ============================================================
# Salin file ini jadi .env lalu isi nilainya.
# Node >= 20.6 otomatis memuat .env, atau pakai: node --env-file=.env server.js
# ============================================================

# PENTING: URL Supabase (bukan anon key dari project lain)
SUPABASE_URL=https://xxxxx.supabase.co

# anon / publishable key. JANGAN pakai service_role key di server.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Paksa backend tertentu. Kosongkan untuk auto-detect:
#   - bila SUPABASE_URL + SUPABASE_ANON_KEY terisi -> pakai Supabase
#   - selain itu -> pakai SQLite lokal (untuk dev)
# Nilai yang bisa dipakai: supabase | sqlite
STORE_BACKEND=

# Port server
PORT=3000
