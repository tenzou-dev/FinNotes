# ============================================================
# Salin file ini jadi .env lalu isi nilainya (server lokal saja).
# Node >= 20.12 otomatis memuat .env, atau pakai: node --env-file=.env server.js
# ============================================================

# File SQLite untuk server lokal (default: data/finnotes.db).
# Test e2e memakai ':memory:'.
SQLITE_FILE=

# Iterasi PBKDF2 untuk hash password (default 10000). Hash lama tetap
# terbaca karena jumlah iterasinya ikut tersimpan di baris hash.
PBKDF2_ITERATIONS=

# Client ID Google OAuth untuk tombol "Lanjut dengan Google" (opsional).
# Bentuknya: xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Port server
PORT=3000
